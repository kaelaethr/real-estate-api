# Kopyaha kini ngadto sa .env ug ilisi ang mga value
# PostgreSQL connection string (local o Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/real_estate?schema=public"

# Secret para sa pag-sign sa JWT (taas ug random nga string)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Port sa API ug ang domain sa frontend para sa CORS
PORT=3000
FRONTEND_URL="http://localhost:5173"
